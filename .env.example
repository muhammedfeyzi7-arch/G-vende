# Kopyalayıp .env olarak kaydedin. Bu değerler istemciye gömülür:
# buraya ASLA service_role anahtarı veya başka gizli anahtar yazmayın.

# Supabase (yalnızca URL ve anon/publishable anahtar)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre stil adresi. Boş bırakılırsa OpenFreeMap "dark" stili kullanılır (anahtarsız).
# Anahtar gerektiren bir sağlayıcı (ör. MapTiler) kullanacaksanız tam URL'yi buraya yazın.
EXPO_PUBLIC_MAP_STYLE_URL=

# Deprem kaynakları (virgülle): afad,kandilli,usgs
EXPO_PUBLIC_QUAKE_SOURCES=afad,kandilli,usgs

# Yalnızca geliştirme: 1 ise backend yokken canlı akışta "ÖRNEK VERİ" etiketli örnek kayıtlar gösterilir.
# Üretim derlemesinde (__DEV__ = false) bu ayar yok sayılır.
EXPO_PUBLIC_DEMO_REPORTS=0
